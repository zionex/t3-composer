config.stopBubbling = true

# @RequiredArgsConstructor / @AllArgsConstructor 가 만드는 생성자 파라미터에
# 필드의 @Qualifier 가 그대로 복사되도록 — Spring DI 가 qualifier 를 인식하려면
# 필드가 아닌 생성자 파라미터에 어노테이션이 있어야 한다.
#
# 사용처: preview 산출물 Service 가 JdbcTemplate 을 target-db 로 라우팅받기 위해
# JavaArtifactRewriter 가 자동 주입한 @Qualifier("targetJdbcTemplate") 가 제대로 동작.
lombok.copyableAnnotations += org.springframework.beans.factory.annotation.Qualifier
