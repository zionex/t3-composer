# ----------------------------------------------------------------------
# T3Composer 단독 환경 환경변수 (예시)
# 실 사용 시 이 파일을 .env 로 복사 후 값을 채우세요. .env 는 git ignored.
# ----------------------------------------------------------------------

# === Anthropic API ===
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# === Composer DB (Docker 내 단독 MSSQL) ===
# SA password 는 MSSQL 정책 (8자 이상, 대소문자+숫자+특수문자) 충족 필요
MSSQL_SA_PASSWORD=Composer!2026
MSSQL_PORT=11433
COMPOSER_DB_NAME=T3SMARTSCM

# === 백엔드 ===
COMPOSER_BACKEND_PORT=8090
COMPOSER_PROFILE=dev

# === 프론트 ===
COMPOSER_FRONTEND_PORT=5173

# === Artifact Apply 모드 ===
# staging  : Docker volume 의 staging/ 폴더에 산출 (검증 후 sync 스크립트로 wingui 동기화)
# direct   : COMPOSER_WINGUI_REF_PATH 가 가리키는 t3series-wingui 폴더에 직접 쓰기
COMPOSER_APPLY_MODE=staging

# === 부모 wingui 프로젝트 경로 (read-only mount) ===
# NEW_FROM_COPY 모드의 sourceBundle 수집 + sync 스크립트의 대상 경로
# Windows 절대경로 (Docker volume 마운트용)
COMPOSER_WINGUI_REF_PATH=C:/Project/t3series/t3series-wingui
COMPOSER_DATABASE_REF_PATH=C:/Project/t3series/t3series-database

# === Composer Database upgrade 폴더 버전 (DDL/SP 산출 시 사용) ===
COMPOSER_UPGRADE_VERSION=v26.0.0-20260507
