# ----------------------------------------------------------------------
# T3Composer 단독 환경 환경변수 (예시)
# 실 사용 시 이 파일을 .env 로 복사 후 값을 채우세요. .env 는 git ignored.
# ----------------------------------------------------------------------

# === Anthropic API ===
# https://console.anthropic.com/ 에서 발급
ANTHROPIC_API_KEY=sk-ant-...

# === Target 거버넌스 스냅샷 암호화 마스터키 ===
# Target 설정 스냅샷에 담기는 시크릿(.env 의 API키·비밀번호, Target db_password)을
# DB 에 저장할 때 Jasypt 로 암호화하는 마스터키. 임의의 충분히 긴 문자열로 설정.
# ★ 분실하면 기존 스냅샷의 시크릿을 복호화할 수 없으니 별도 안전한 곳에 백업할 것.
# ★ 이 값 자체는 스냅샷에 저장되지 않음 — 복원 시 백엔드가 .env 에 다시 기록.
# 변경 후 'docker compose up -d --force-recreate composer-backend' 재기동 필요.
COMPOSER_SNAPSHOT_SECRET_KEY=

# === Composer DB (Docker 내 단독 PostgreSQL — 2026-05-11 전환) ===
# Composer 의 운영 데이터 (세션·메시지·아티팩트·패턴·사전) 보관. 라이센스 free.
# Target System 의 DB (운영 wingui MSSQL 등) 와 무관. 산출물은 Target dialect 그대로.
COMPOSER_DB_USER=composer
COMPOSER_DB_PASSWORD=Composer!2026
COMPOSER_DB_NAME=t3composer
COMPOSER_DB_PORT=15432

# === Target Operational DB (MSSQL — 화면 실행 시 산출물 SP/DDL 적용 대상) ===
# T3SERIES/PLANNEL/LGES_NEXTSCM 모두 MSSQL 방언이라 공유 컨테이너 1대.
# 추후 dialect 가 다른 Target (Oracle/DB2) 추가 시 별도 컨테이너 추가.
TARGET_MSSQL_PASSWORD=Composer!2026
TARGET_MSSQL_PORT=11433
TARGET_DB_NAME=T3SMARTSCM

# === Per-Target System DB 접속 정보 (외부 운영/개발 DB 연결용) ===
# 비워두면 startup 시 DB 의 기존 값 유지 (로컬 target-mssql 컨테이너 사용).
# 외부 T3Series 개발 DB 로 연결하려면 아래 값을 채우고 'docker compose up -d composer-backend' 재기동.
# 적용 후엔 [기존화면복사]/[기존화면수정] 이 해당 DB 의 실시간 메뉴/LangPack 사용.
TARGET_T3SERIES_DB_URL=
TARGET_T3SERIES_DB_USERNAME=
TARGET_T3SERIES_DB_PASSWORD=
TARGET_T3SERIES_DB_DRIVER_CLASS=com.microsoft.sqlserver.jdbc.SQLServerDriver

# === 백엔드 ===
COMPOSER_BACKEND_PORT=8090
COMPOSER_PROFILE=dev

# === 프론트 ===
COMPOSER_FRONTEND_PORT=5173

# === Insight ===
# ── INSIGHT_API_BASE — browser 가 insight-llm 으로 직접 호출할 때 사용 ──
# URL 관점: 호스트 PC (browser 시점) — default 'http://localhost:9160'
# 적용 시점: webpack DefinePlugin 이 빌드 시점에 literal 로 치환 → frontend 재기동 필요
#   docker compose up -d --force-recreate composer-frontend
INSIGHT_API_BASE=

# ── INSIGHT_LLM_BASE_URL — backend container 가 upstream insight-llm 으로 프록시할 때 사용 ──
# URL 관점: 컨테이너 내부 (Spring WebClient 시점) — default 'http://host.docker.internal:9160'
#   ※ 컨테이너 안 'localhost' 는 자기 자신을 가리키므로 호스트 9160 을 가리키려면 host.docker.internal 필수.
# 적용 시점: application.yaml 의 ${INSIGHT_LLM_BASE_URL:...} → backend 재기동 필요
#   docker compose up -d --force-recreate composer-backend
INSIGHT_LLM_BASE_URL=

# ── INSIGHT_ENABLED — Insight 연동 UI 토글 (frontend 빌드 플래그, default: false) ──
# 효과: false 시 [Dashboard 메뉴 · Insight AI 탭 · ModeNewStep Dashboard 카드] 3곳 숨김
# 적용 시점: webpack DefinePlugin 이 빌드 시점에 'true'/'false' literal 로 치환 → frontend 재기동 필요
#   docker compose up -d --force-recreate composer-frontend
INSIGHT_ENABLED=false

# === Artifact Apply 모드 ===
# staging : Docker volume 의 staging/ 폴더 fallback (Per-Target 미해석 시).
# (2026-05-28) direct 모드 폐기 — Per-Target source 경로 (TARGET_<CD>_PATH) 가
# TargetPathResolver 우선순위로 자동 채택.
COMPOSER_APPLY_MODE=staging

# === Target source 경로 (단일 변수 — backend + frontend 모두) ===
# TARGET_T3SERIES_PATH 가 모든 용도의 단일 진실 저장소:
#  · backend: 산출물 적용 대상 (TargetPathResolver 가 자동 채택)
#  · frontend: 빌드 의존성 (webpack alias / RealGrid2 entrypoint 자동 복사)
# T3SERIES 는 wingui 모노레포 (packages/wingui/realgrid 보유) 구조 전제.
# 다른 Target (PLANNEL 등) 도 TARGET_T3SERIES_PATH 가 frontend 빌드 의존성 채워줘야 함.

# === Target System 별 source / database 폴더 슬롯 (★ 호스트→컨테이너 마운트의 단일 진실 저장소) ===
# Composer 의 다이얼로그(Storage)에서 호스트 path 를 받지 않습니다. 모든 마운트 경로는 여기서 결정됩니다.
#
# Target 마다 **호스트 절대경로** 를 지정 — 드라이브가 달라도 (C: / D:) 독립 마운트됨.
# 각 슬롯은 컨테이너 안에서 자동으로 /workspace/targets/<CD>/{wingui|database} 로 보임.
# (컨테이너 마운트 path 의 'wingui' 토큰은 TargetPathResolver contract 잔재 — 실제 의미는 'source 폴더'.
#  env var 이름은 TARGET_<CD>_PATH 로 통일됨 — 2026-06-04.)
# 미설정 슬롯은 ./empty (빈 폴더) 로 마운트되어 무해.
#
# 변경 후 반드시 backend 컨테이너 재기동:
#   docker compose up -d --force-recreate composer-backend
#
# 새 Target 을 docker-compose.yml 에 추가하려면 거기에도 같은 패턴의 슬롯 라인을 함께 추가해야 합니다.

# T3SERIES — 메인 source 폴더 경로 (예: C 드라이브)
TARGET_T3SERIES_PATH=C:/Project/t3series/t3series-wingui

# PLANNEL — frontend(saas-web) 와 backend(saas-application) 가 분리 구조.
# EXISTING_MODIFY 모드의 소스 수집이 backend 까지 보려면 BACKEND_PATH 도 설정.
TARGET_PLANNEL_PATH=
TARGET_PLANNEL_BACKEND_PATH=

# LGES_NEXTSCM
TARGET_LGES_NEXTSCM_PATH=

# === Per-Target 프로젝트 루트 (Ontology Import 기능용 — 2026-06-08 추가) ===
# .insight_code/ontology_v2 폴더가 있는 프로젝트 루트의 호스트 절대경로.
#
# 용도: Ontology Tab 의 [📥 파일에서 Import] 가 이 폴더의 JSON 파일을 읽어
#       Target DB (TB_IS_QAPATTERN 등) 로 1회 복사. skip-existing 정책이라
#       이미 있는 id 는 건드리지 않음.
#
# 어디서 가져온 데이터냐: t3series-bfserver (GraphRAG 추출기) 가 DB → JSON 으로
# dump 한 결과. bfserver 가 운영되는 프로젝트는 DB 가 이미 채워져 있으므로
# 본 변수 미설정으로 무방. bfserver 없이 deploy 하는 경우만 본 변수로 폴더 위치를
# 지정해 Import 1회 클릭으로 DB 시드.
#
# T3SERIES 처럼 wingui 가 nested (project_root/t3series-wingui/...) 인 경우
# wingui 경로의 한 단계 위 (project_root) 를 지정. 미설정 시 TARGET_<CD>_PATH 에
# 폴백 — wingui = project root 인 평탄 구조 Target 호환.
#
# 예:
#   TARGET_T3SERIES_PROJECT_PATH=C:/vs_project/t3series_dev
TARGET_T3SERIES_PROJECT_PATH=
TARGET_PLANNEL_PROJECT_PATH=
TARGET_LGES_NEXTSCM_PROJECT_PATH=

# === Workspace 부모 폴더 (UI 폴더 탐색의 root) ===
# (2026-06-04) UI 의 [📁 Source 등록] 다이얼로그가 이 폴더 안만 탐색 가능.
# 기본은 ${HOME}/work/projects — 사내 SCM repo 가 다 이 밑에 있을 때 자연스러움.
# 변경 시 docker compose up -d --force-recreate composer-backend 필요.
COMPOSER_WORKSPACE_ROOT=

# Target 별 .claude 규약 overlay 폴더 (POST /composer/targets/{cd}/import-claude 가 읽음)
# 2026-06 재구조화: 공용 + Target overlay 2단 구조.
#   .claude/                    = 공용 rules + hooks (모든 Target — 자동 마운트, 변수 X)
#   .claude/targets/t3series/   = T3SERIES 전용 overlay (자동 마운트가 기본)
#   .claude/targets/plannel/    = PLANNEL  전용 overlay (자동 마운트가 기본)
# 변수 비워두면 위 기본 overlay 가 마운트됨. 부모 source repo 의 .claude 를 overlay 로 쓰려면
# 절대경로로 명시:
#   COMPOSER_T3SERIES_OVERLAY_PATH=C:/Project/t3series/.claude
#   COMPOSER_PLANNEL_OVERLAY_PATH=C:/Project/saas-plannel/.claude
# ⚠️ 옛 변수명 COMPOSER_T3SERIES_CLAUDE_PATH / COMPOSER_PLANNEL_CLAUDE_PATH 는 deprecated —
#    docker-compose.yml 이 더 이상 참조하지 않음 (옛 평탄 폴더 가리키므로). 새 이름 OVERLAY_PATH 사용.
# 기본 동작 (본 repo 의 ./.claude/targets/<cd> 사용) 이면 비워두기.
# 부모 source repo 의 .claude 를 overlay 로 쓰고 싶을 때만 절대경로로 채움.
COMPOSER_T3SERIES_OVERLAY_PATH=
COMPOSER_PLANNEL_OVERLAY_PATH=
COMPOSER_LGES_NEXTSCM_OVERLAY_PATH=

# === Composer Database upgrade 폴더 버전 (DDL/SP 산출 시 사용) ===
COMPOSER_UPGRADE_VERSION=v26.0.0-20260507

# === LLM Backend 선택 (2026-06-02 추가) ===
# api  (기본): Anthropic HTTP API 사용 — ANTHROPIC_API_KEY 필요
# cli         : 호스트 ~/.claude 로그인 + 컨테이너 안 claude CLI subprocess 사용
#               (구독 정액제로 비용 절감. 호스트에서 미리 'claude /login' 필요)
# 변경 후 'docker compose up -d --force-recreate composer-backend' 재기동.
LLM_BACKEND=api

# CLI 모드 전용 (LLM_BACKEND=cli 일 때만 의미 있음)
LLM_CLI_BINARY=/usr/bin/claude
LLM_CLI_TIMEOUT_MIN=40
LLM_CLI_MAX_CONCURRENT=4

# 인증키 기본값
COMPOSER_AUTH_KEY_PREFIX=zjavhwj