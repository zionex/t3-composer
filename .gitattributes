# =============================================================================
# Line ending 일관성 — Windows/macOS/Linux/Docker 혼용 환경 대응
# =============================================================================
# 텍스트 파일은 working tree 에서 OS 기본 (Windows 는 CRLF), git 에는 LF 로 저장.

* text=auto eol=lf

# Windows 전용 — 항상 CRLF (Windows 셸이 LF 못 읽음)
*.bat       text eol=crlf
*.cmd       text eol=crlf
*.ps1       text eol=crlf

# Unix 전용 — 항상 LF (Docker container 안의 entrypoint 등)
*.sh        text eol=lf
Dockerfile  text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.sql       text eol=lf

# 코드 파일 — LF (cross-platform 빌드)
*.java      text eol=lf
*.js        text eol=lf
*.jsx       text eol=lf
*.ts        text eol=lf
*.tsx       text eol=lf
*.json      text eol=lf
*.css       text eol=lf
*.html      text eol=lf
*.md        text eol=lf
*.xml       text eol=lf

# Binary — line ending 무관
*.png       binary
*.jpg       binary
*.jpeg      binary
*.gif       binary
*.ico       binary
*.zip       binary
*.jar       binary
*.war       binary
*.xlsx      binary
*.xls       binary
*.pdf       binary
