# IDE
.idea/
.vscode/
*.iml
.classpath
.project
.settings/

# Claude local settings (user-specific)
.claude/settings.local.json

# Java
target/
*.class
*.jar
!gradle/wrapper/gradle-wrapper.jar
.mvn/
mvnw
mvnw.cmd

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Build output
dist/
build/
out/

# Logs
logs/
*.log

# OS
.DS_Store
Thumbs.db

# Environment & secrets
# .env 는 placeholder 상태로 레포에 commit 되어 있음 (.env.example 동일 내용).
# 사용자가 실제 시크릿을 채워도 git status 에는 modified 로 뜨므로 — ★ push 금지 ★.
# 환경별 override 만 ignore.
.env.local
.env.*.local
*.key
secrets/

# Composer artifact staging (산출물 — git 관리 X)
# staging/ 아래는 모두 화면 실행/적용/sync 산출물. .gitkeep 만 추적 유지하여
# 빈 staging/ 디렉토리 구조는 git 에 남기되 내부 산출물은 모두 ignore.
staging/*
!staging/.gitkeep

# Composer Phase 2 preview (docker 내 검증용 임시 산출물)
frontend/src/view/_preview/*
!frontend/src/view/_preview/.gitkeep
backend/src/main/java/com/zionex/t3composer/preview/

# DevTools restart trigger (mvn worker thread 가 touch 하는 runtime artifact)
backend/.devtools-restart-trigger
backend/target/classes/.devtools-restart-trigger

# Claude scheduled tasks lock (runtime)
.claude/scheduled_tasks.lock
.claude/scheduled_tasks/

# Docker
.docker-volumes/
docker-data/

# Test coverage
coverage/
.nyc_output/

# Temporary
*.tmp
*.bak
*.swp

# Superpowers brainstorming sessions (runtime mockups, not source)
.superpowers/
